# ── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ── Pexels stock images ───────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_key_here

# ── YouTube OAuth2 ────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json

# ── Content preferences ───────────────────────────────────────────────────────
PREFERRED_NICHE=finance south africa
TTS_VOICE=en-ZA-LeahNeural

# ── Scheduler ─────────────────────────────────────────────────────────────────
UPLOAD_TIME_SAST=18:00
VIDEOS_PER_DAY=1

# ── Flask server ──────────────────────────────────────────────────────────────
FLASK_PORT=5000
WEBHOOK_SECRET=your_secret_here

# ── Optional: callback URL for failure notifications ──────────────────────────
FAILURE_CALLBACK_URL=
