# ╔══════════════════════════════════════════════════════════════╗
# ║           TrendEmpire Bot — Environment Variables           ║
# ╚══════════════════════════════════════════════════════════════╝

# ── AI / Content Generation ───────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
PEXELS_API_KEY=your_pexels_key_here

# ── Content preferences ───────────────────────────────────────────────────────
PREFERRED_NICHE=finance south africa
TTS_VOICE=en-ZA-LeahNeural

# ── Scheduler ─────────────────────────────────────────────────────────────────
UPLOAD_TIME_SAST=18:00
VIDEOS_PER_DAY=1

# ── Flask server ──────────────────────────────────────────────────────────────
FLASK_PORT=5000
WEBHOOK_SECRET=your_secret_here

# ── Server public URL (needed for Instagram Reel uploads) ─────────────────────
# Example: http://123.45.67.89:5000  or  https://yourdomain.com
SERVER_BASE_URL=http://YOUR_SERVER_IP:5000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PLATFORM CREDENTIALS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── YouTube OAuth2 ────────────────────────────────────────────────────────────
# Download client_secret.json from Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json

# ── TikTok Content Posting API v2 ────────────────────────────────────────────
# Get from: developers.tiktok.com → Your App → Keys and Tokens
# Scope required: video.publish
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ── Meta (Facebook Reels + Instagram Reels) ───────────────────────────────────
# Get from: developers.facebook.com → Your App → Tools → Graph API Explorer
# Token type: Page Access Token (long-lived, never expires if refreshed monthly)
# Permissions: pages_manage_posts, pages_read_engagement, instagram_content_publish
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_FACEBOOK_PAGE_ID=your_facebook_page_numeric_id
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ── Twitter / X ───────────────────────────────────────────────────────────────
# Get from: developer.twitter.com → Your App → Keys and Tokens
# Free tier: text posts only. Basic ($100/mo): video uploads.
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ── Pinterest ─────────────────────────────────────────────────────────────────
# Get from: developers.pinterest.com → My Apps → Access Token
# Scope: boards:read, pins:write
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_pinterest_board_id

# ── Spotify / Podcast via Buzzsprout ─────────────────────────────────────────
# 1. Create account at buzzsprout.com (free: 3h audio/month)
# 2. Connect Spotify under Directories tab (one-time)
# 3. Get Podcast ID from your Buzzsprout dashboard URL: /api/{podcast_id}
# 4. Get API Token from Profile → API
BUZZSPROUT_PODCAST_ID=your_buzzsprout_podcast_id
BUZZSPROUT_API_KEY=your_buzzsprout_api_key

# ── Optional thumbnail URL for Pinterest pins ─────────────────────────────────
DEFAULT_THUMBNAIL_URL=

# ── Optional: failure notification callback ───────────────────────────────────
FAILURE_CALLBACK_URL=
